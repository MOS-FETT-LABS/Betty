[
    {
        "type": "heading",
        "defaultValue": "Betty",
        "size": 1
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Assistant"
            },
            {
                "type": "select",
                "id": "ASSISTANT_RUNTIME",
                "messageKey": "ASSISTANT_RUNTIME",
                "label": "Runtime",
                "description": "Automatic sends prompts to Betty Companion when it is installed. Choose Companionless when using only the PBW.",
                "defaultValue": "automatic",
                "options": [
                    {"label": "Automatic", "value": "automatic"},
                    {"label": "Companionless", "value": "companionless"},
                    {"label": "Android companion", "value": "android"}
                ]
            },
            {
                "type": "input",
                "id": "OPENCODE_API_KEY",
                "messageKey": "GEMINI_API_KEY",
                "label": "OpenCode Go API key",
                "description": "Your OpenCode Go API key from opencode.ai/console. Stored locally by the Pebble phone app. Required for companionless mode.",
                "defaultValue": ""
            },
            {
                "type": "select",
                "id": "OPENCODE_MODEL",
                "messageKey": "GEMINI_MODEL",
                "label": "Model",
                "description": "OpenCode Go models, from lightest to heaviest. Lighter models answer faster and cost less; heavier models reason better for harder questions.",
                "defaultValue": "glm-5.3-flash",
                "options": [
                    {"label": "DeepSeek V4.1 Flash (lightest)", "value": "deepseek-v4.1-flash"},
                    {"label": "Qwen 3.8 Flash", "value": "qwen3.8-flash"},
                    {"label": "GLM 5.3 Flash (recommended)", "value": "glm-5.3-flash"},
                    {"label": "MiniMax M3.1 Flash", "value": "minimax-m3.1-flash"},
                    {"label": "DeepSeek V4 Pro (heavy)", "value": "deepseek-v4-pro"},
                    {"label": "GLM 5.3 (heaviest)", "value": "glm-5.3"}
                ]
            },
            {
                "type": "input",
                "id": "OPENCODE_MONTHLY_BUDGET_USD",
                "messageKey": "GEMINI_MONTHLY_BUDGET_USD",
                "label": "Monthly budget",
                "description": "Used only for Betty's local usage estimate on the Quota screen. The OpenCode Console is authoritative for your Go allowance.",
                "defaultValue": "10"
            },
            {
                "type": "input",
                "id": "GITHUB_ISSUES_URL",
                "messageKey": "GITHUB_ISSUES_URL",
                "label": "Feedback GitHub issues URL",
                "description": "Feedback opens a prefilled issue here. Use your fork's /issues/new URL.",
                "defaultValue": "https://github.com/MOS-FETT-LABS/betty/issues/new"
            },
            {
                "type": "input",
                "id": "FEEDBACK_POST_URL",
                "messageKey": "FEEDBACK_POST_URL",
                "label": "Feedback POST endpoint",
                "description": "Optional. Bobby-style feedback posts JSON here and returns Sent/Error on the watch. Leave blank to open a prefilled GitHub issue instead.",
                "defaultValue": ""
            },
            {
                "type": "input",
                "id": "USER_PROFILE_CONTEXT",
                "messageKey": "USER_PROFILE_CONTEXT",
                "label": "Betty profile context",
                "description": "Optional companionless memory/profile notes Betty should use, such as preferred name, home timezone, family names, pets, or preferences. Stored locally by the Pebble phone app.",
                "defaultValue": ""
            }
        ]
    },
