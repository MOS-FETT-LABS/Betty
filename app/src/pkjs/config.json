                    {"label": "Reveille", "value": "1"},
                    {"label": "Mario", "value": "2"},
                    {"label": "Nudge Nudge", "value": "3"},
                    {"label": "Jackhammer", "value": "4"},
                    {"label": "Standard", "value": "5"}
                ]
            },
            {
                "type": "select",
                "messageKey": "QUICK_LAUNCH_BEHAVIOUR",
                "label": "Quick launch behaviour",
                "description": "What to do when Betty is launched via Quick Launch. If 'start conversation' is selected, Betty will start listening immediately. If 'stay open' is chosen, Betty will quit after a minute of inactivity. If 'open home screen' is chosen, Betty will behave the same as if launched from the app launcher.",
                "defaultValue": "1",
                "options": [
                    {"label": "Start conversation and time out", "value": "1"},
                    {"label": "Start conversation then stay open", "value": "2"},
                    {"label": "Open home screen", "value": "3"}
                ]
            },
            {
                "type": "toggle",
                "messageKey": "CONFIRM_TRANSCRIPTS",
                "defaultValue": false,
                "label": "Confirm prompts before responding",
                "description": "When enabled, after dictating to the watch, you'll always be asked to confirm your input before Betty takes action. When disabled, Betty will respond immediately to whatever was recognised."
